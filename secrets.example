# ~/.secrets — machine-local secrets, never commit this file
#
# Setup:
#   cp secrets.example ~/.secrets && chmod 600 ~/.secrets
#   edit ~/.secrets, then start a new shell (sourced by zshenv)

# Conan / Artifactory
export CONAN_LOGIN_USERNAME=""
export CONAN_PASSWORD=""

# Azure DevOps
export AZURE_DEVOPS_EXT_USER=""
export AZURE_DEVOPS_EXT_PAT=""
export AZURE_DEVOPS_ORGS=""  # space-separated org slugs, e.g. "org-one org-two"

# GitHub (used by curl/pip via .netrc; git uses gh auth git-credential)
export GITHUB_TOKEN=""

# Anthropic / Azure AI Foundry
export ANTHROPIC_FOUNDRY_API_KEY=""

# License server
export TESTWELLD_LICENSE_FILE=""  # e.g. PORT@license-server-hostname
