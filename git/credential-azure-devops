#!/bin/sh
# Git credential helper using the Azure DevOps CLI extension environment variables.
# It deliberately does not persist credentials; set these in the environment.

case "$1" in
  get)
    if [ -n "${AZURE_DEVOPS_BDC_USER:-}" ] && [ -n "${AZURE_DEVOPS_BDC_PAT:-}" ]; then
      printf 'username=%s\npassword=%s\n\n' "$AZURE_DEVOPS_BDC_USER" "$AZURE_DEVOPS_BDC_PAT"
    fi
    ;;
  store|erase)
    # Credentials are sourced from the environment, never persisted.
    ;;
esac
