# ~/.config/git/credentials — GENERATED FILE (mode 600)
# Do not edit manually. Source of truth is ~/.secrets
# Regenerate with: source ~/.secrets && secrets-apply
#
# Pulled in as git config via [include] in ~/.config/git/work,
# so this file uses git-config syntax, not plaintext credential lines.
#
# One [url] block per org listed in $AZURE_DEVOPS_ORGS, e.g.:

[url "https://<AZURE_DEVOPS_EXT_USER>:<AZURE_DEVOPS_EXT_PAT>@dev.azure.com/<ORG>"]
    insteadOf = https://<AZURE_DEVOPS_EXT_USER>@dev.azure.com/<ORG>
