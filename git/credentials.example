# ~/.config/git/credentials — machine-local, never commit this file
#
# Setup:
#   cp git/credentials.example ~/.config/git/credentials
#   chmod 600 ~/.config/git/credentials
#   replace the <PLACEHOLDER> values with your real credentials

[url "https://<AZURE_DEVOPS_EXT_USER>:<AZURE_DEVOPS_EXT_PAT>@dev.azure.com/REDACTED-ORG-1"]
    insteadOf = https://<AZURE_DEVOPS_EXT_USER>@dev.azure.com/REDACTED-ORG-1

[url "https://<AZURE_DEVOPS_EXT_USER>:<AZURE_DEVOPS_EXT_PAT>@dev.azure.com/REDACTED-ORG-2"]
    insteadOf = https://<AZURE_DEVOPS_EXT_USER>@dev.azure.com/REDACTED-ORG-2
