#!/usr/bin/bash
set -euo pipefail

# Bubblewrap sandbox for pi (pi-coding-agent). Mirrors claude-bwrapped.
#
#   /nix              ro — pi's Node.js runtime and closure dependencies.
#   ~/.nix-profile    recreated as a symlink into ~/.local/state/nix/profiles/.
#   ~/.pi             rw — pi agent dir: settings, models.json, sessions, auth.
#   ~/.config/gh      ro — GitHub CLI auth.
#   ~/.cache/pi       rw — pi's own cache; narrowed from ~/.cache.
#   ~/.secrets        parsed and injected as --setenv args; not bound.
#   ~/ws              rw — workspace root, for git worktree metadata.
#   $(pwd)            rw — the project being worked on (--chdir target).
#
# Sensitive dirs hidden (tmpfs over $HOME, then selectively re-exported):
#   ~/.ssh, ~/.gnupg, ~/.azure, ~/.config (except gh), ~/.copilot

ulimit -t 600           # CPU time (seconds)
ulimit -v $((20 << 20)) # 20 GiB virtual memory
ulimit -u 1000          # Max processes
ulimit -f 1048576       # Max file size (512 MiB; unit is 512-byte blocks)

mkdir -p "$HOME/.pi" "$HOME/.cache/pi"
touch "$HOME/.pi.json"

# Pass through selected vars from the outer environment if set. --clearenv
# drops everything, so any var the sandbox needs must be re-injected here.
declare -a passthrough_envs=()
for var in http_proxy HTTP_PROXY https_proxy HTTPS_PROXY no_proxy NO_PROXY \
  UV_INDEX_URL UV_EXTRA_INDEX_URL; do
  [[ -n "${!var+x}" ]] && passthrough_envs+=(--setenv "$var" "${!var}")
done

# Append --setenv args for each KEY=value line in the file at $1 to the array
# named by $2. Later entries override earlier ones for the same key.
parse_env_file() {
  local file="$1"
  local -n envs="$2"
  local line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#export }"
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line//[[:space:]]/}" ]] && continue
    key="${line%%=*}"
    value="${line#*=}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    # Strip surrounding quotes
    if [[ "$value" =~ ^\"(.*)\"$ ]] || [[ "$value" =~ ^\'(.*)\'$ ]]; then
      value="${BASH_REMATCH[1]}"
    fi
    envs+=(--setenv "$key" "$value")
  done <"$file"
}

declare -a secret_envs=()
if [[ -f "$HOME/.secrets" ]]; then
  parse_env_file "$HOME/.secrets" secret_envs
fi

exec bwrap \
  --new-session \
  --die-with-parent \
  --unshare-all \
  --share-net \
  --cap-drop all \
  --ro-bind /usr /usr \
  --ro-bind /etc /etc \
  --ro-bind /bin /bin \
  --ro-bind /sbin /sbin \
  --ro-bind-try /lib /lib \
  --ro-bind-try /lib64 /lib64 \
  --ro-bind /nix /nix \
  --tmpfs /tmp \
  --tmpfs /var/tmp \
  --proc /proc \
  --dev /dev \
  --tmpfs "$HOME" \
  --ro-bind "$HOME/.local/state/nix" "$HOME/.local/state/nix" \
  --ro-bind "$HOME/.local/bin" "$HOME/.local/bin" \
  --ro-bind-try "$HOME/.local/share/uv" "$HOME/.local/share/uv" \
  --symlink "$HOME/.local/state/nix/profiles/profile" "$HOME/.nix-profile" \
  --ro-bind-try "$HOME/.gitconfig" "$HOME/.gitconfig" \
  --ro-bind-try "$HOME/.gitignore" "$HOME/.gitignore" \
  --ro-bind-try "$HOME/.config/git" "$HOME/.config/git" \
  --ro-bind "$HOME/bin" "$HOME/bin" \
  --bind-try "$HOME/.pi.json" "$HOME/.pi.json" \
  --bind "$HOME/.pi" "$HOME/.pi" \
  --ro-bind "$HOME/.config/gh" "$HOME/.config/gh" \
  --dir "$HOME/.cache" \
  --bind "$HOME/.cache/pi" "$HOME/.cache/pi" \
  --bind-try "$HOME/ws" "$HOME/ws" \
  --bind "$(pwd)" "$(pwd)" \
  --chdir "$(pwd)" \
  --hostname sandbox \
  --clearenv \
  --setenv HOME "$HOME" \
  --setenv HOSTNAME "$HOSTNAME" \
  --setenv USER "$(id -un)" \
  --setenv LOGNAME "$(id -un)" \
  --setenv SHELL "${SHELL:-/bin/bash}" \
  --setenv TERM "${TERM:-xterm-256color}" \
  --setenv XDG_CACHE_HOME "$HOME/.cache" \
  --setenv PATH "$HOME/.nix-profile/bin:$HOME/bin:/usr/bin:/usr/sbin:/bin:$HOME/.local/bin" \
  --setenv LANG "${LANG:-C.UTF-8}" \
  --setenv LC_ALL "${LC_ALL:-C.UTF-8}" \
  "${passthrough_envs[@]}" \
  "${secret_envs[@]}" \
  -- "$HOME/.local/bin/pi" "$@"
